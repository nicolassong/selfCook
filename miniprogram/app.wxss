page {
  background: #f7f8fa;
  color: #111827;
}

.container {
  padding: 24rpx;
}

.page-shell {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 24%, #f8fafc 100%);
}

.page-title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.section-title {
  margin: 30rpx 4rpx 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.card,
.surface-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.elevated-card {
  background: #fff;
  border-radius: 28rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.title,
.card-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.sub,
.muted-text {
  font-size: 24rpx;
  color: #6b7280;
}

.price,
.price-text {
  color: #ef4444;
  font-size: 32rpx;
  font-weight: 700;
}

.row,
.between-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tag,
.status-pill {
  display: inline-block;
  padding: 6rpx 16rpx;
  background: #ecfdf5;
  color: #059669;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.status-pill--warm {
  background: #ffedd5;
  color: #ea580c;
}

.status-pill--info {
  background: #dbeafe;
  color: #2563eb;
}

.status-pill--danger {
  background: #fee2e2;
  color: #dc2626;
}

.btn-primary,
.gradient-btn {
  background: linear-gradient(135deg, #f97316, #fb7185);
  color: #fff;
  border-radius: 999rpx;
  border: none;
  font-weight: 700;
}

.btn-dark {
  background: #111827;
  color: #fff;
  border-radius: 999rpx;
  border: none;
}

.btn-ghost {
  background: #fff7ed;
  color: #f97316;
  border-radius: 999rpx;
  border: none;
}

.btn-danger-soft {
  background: #fee2e2;
  color: #dc2626;
  border-radius: 999rpx;
  border: none;
}

.field-input,
.field-picker,
.input-surface {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f9fafb;
  font-size: 26rpx;
  color: #111827;
}

.fixed-action-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(12rpx);
}

.dark-amount-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #111827, #1f2937);
  color: #fff;
  box-shadow: 0 18rpx 48rpx rgba(17, 24, 39, 0.14);
}

.warm-hero-card {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #fff;
  box-shadow: 0 24rpx 56rpx rgba(249, 115, 22, 0.22);
}

.dark-hero-card {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #111827, #1f2937);
  color: #fff;
  box-shadow: 0 24rpx 56rpx rgba(17, 24, 39, 0.18);
}
