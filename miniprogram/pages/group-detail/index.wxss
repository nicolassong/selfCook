.detail-page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 24%, #f8fafc 100%);
}

.hero-card {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #fb923c, #f97316);
  color: #fff;
  box-shadow: 0 24rpx 56rpx rgba(249, 115, 22, 0.22);
}

.hero-top,
.item-top,
.item-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.hero-title {
  font-size: 40rpx;
  font-weight: 700;
}

.hero-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.92);
}

.hero-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 22rpx;
  font-weight: 600;
}

.hero-meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.item-meta-row {
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}

.meta-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #f3f4f6;
  color: #4b5563;
  font-size: 22rpx;
}

.section-title {
  margin: 30rpx 4rpx 18rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.item-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.item-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.item-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.price-wrap {
  display: flex;
  align-items: flex-end;
  color: #f97316;
}

.price-symbol {
  font-size: 24rpx;
  margin-bottom: 4rpx;
}

.price-value {
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1;
}

.item-bottom {
  margin-top: 26rpx;
}

.stock-chip {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #fff7ed;
  color: #ea580c;
  font-size: 22rpx;
}

.buy-btn {
  margin: 0;
  padding: 0 28rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #f97316, #fb7185);
  color: #fff;
  font-size: 24rpx;
  font-weight: 600;
}

.buy-btn-disabled {
  background: #d1d5db;
  color: #6b7280;
}

