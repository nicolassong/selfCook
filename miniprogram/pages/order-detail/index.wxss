.order-detail-page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 24%, #f8fafc 100%);
}

.status-card,
.detail-card,
.goods-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  background: linear-gradient(135deg, #111827, #1f2937);
  color: #fff;
}

.status-title {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.78);
}

.status-text {
  margin-top: 10rpx;
  font-size: 38rpx;
  font-weight: 700;
}

.status-no {
  max-width: 280rpx;
  text-align: right;
  font-size: 22rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.84);
}

.detail-card,
.amount-card,
.goods-card {
  margin-top: 22rpx;
}

.card-title,
.standalone {
  font-size: 28rpx;
  font-weight: 700;
  color: #111827;
}

.detail-line {
  margin-top: 14rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #4b5563;
}

.amount-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #f97316, #fb7185);
  color: #fff;
  box-shadow: 0 18rpx 48rpx rgba(249, 115, 22, 0.18);
}

.card-title.light {
  color: #fff;
}

.amount-row,
.goods-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.amount-row {
  margin-top: 16rpx;
  font-size: 25rpx;
}

.amount-row.total {
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.22);
  font-size: 34rpx;
  font-weight: 700;
}

.standalone {
  margin: 28rpx 4rpx 0;
}

.goods-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.goods-sub,
.goods-unit {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #6b7280;
}

.goods-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #f97316;
}
