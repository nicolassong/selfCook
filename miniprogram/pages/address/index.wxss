.address-page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 24%, #f8fafc 100%);
}

.page-title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.form-card,
.address-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.card-title,
.address-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.field-input {
  margin-top: 16rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f9fafb;
  font-size: 26rpx;
  color: #111827;
}

.save-btn {
  margin-top: 20rpx;
  border: none;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #f97316, #fb7185);
  color: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.address-top,
.action-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.default-tag {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #ea580c;
  font-size: 22rpx;
  font-weight: 600;
}

.address-phone,
.address-detail {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}

.action-row {
  margin-top: 22rpx;
}

.ghost-btn,
.danger-btn {
  margin: 0;
  flex: 1;
  border-radius: 999rpx;
  font-size: 22rpx;
}

.ghost-btn {
  background: #fff7ed;
  color: #f97316;
}

.danger-btn {
  background: #fee2e2;
  color: #dc2626;
}
