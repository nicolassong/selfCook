.orders-page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 24%, #f8fafc 100%);
}

.page-title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.order-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.order-head,
.order-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.order-no {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.order-contact {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #6b7280;
}

.order-tag {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: #ffedd5;
  color: #ea580c;
  font-size: 22rpx;
  font-weight: 600;
}

.order-body {
  margin-top: 22rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f1f5f9;
}

.order-meta {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #4b5563;
}

.order-meta:first-child {
  margin-top: 0;
}

.order-foot {
  margin-top: 24rpx;
}

.detail-link {
  font-size: 24rpx;
  font-weight: 600;
  color: #f97316;
}

.cancel-btn {
  margin: 0;
  height: 68rpx;
  line-height: 68rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  background: #fee2e2;
  color: #dc2626;
  font-size: 24rpx;
  font-weight: 600;
}
