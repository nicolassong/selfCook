.order-page {
  min-height: 100vh;
  padding: 32rpx 32rpx 180rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 22%, #f8fafc 100%);
}

.order-panel,
.amount-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.panel-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.field-block {
  margin-top: 24rpx;
}

.field-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #374151;
}

.field-input,
.field-picker,
.qty-value {
  margin-top: 14rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #f9fafb;
  font-size: 26rpx;
  color: #111827;
}

.quantity-box,
.field-row,
.amount-row,
.submit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.quantity-box {
  gap: 16rpx;
  margin-top: 14rpx;
}

.qty-btn {
  width: 76rpx;
  height: 76rpx;
  line-height: 76rpx;
  margin: 0;
  border-radius: 20rpx;
  border: none;
  background: #fff7ed;
  color: #f97316;
  font-size: 30rpx;
  font-weight: 700;
}

.qty-value {
  flex: 1;
  margin-top: 0;
  text-align: center;
}

.field-link {
  font-size: 24rpx;
  color: #f97316;
  font-weight: 600;
}

.quick-actions {
  display: flex;
  gap: 10rpx;
}

.quick-btn {
  margin: 0;
  height: 54rpx;
  line-height: 54rpx;
  border-radius: 999rpx;
  border: none;
  padding: 0 18rpx;
  background: #fed7aa;
  color: #9a3412;
  font-size: 20rpx;
}

.quick-btn-ghost {
  background: #f3f4f6;
  color: #4b5563;
}

.item-brief {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 22rpx;
  background: #f9fafb;
}

.item-brief-disabled {
  opacity: 0.6;
}

.item-brief-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.item-price {
  font-size: 30rpx;
  color: #f97316;
  font-weight: 700;
}

.item-title {
  font-size: 26rpx;
  color: #111827;
  font-weight: 600;
}

.item-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #6b7280;
}

.hint-text {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ef4444;
}

.amount-card {
  margin-top: 22rpx;
  background: linear-gradient(135deg, #111827, #1f2937);
  color: #fff;
}

.amount-row {
  margin-top: 16rpx;
  font-size: 25rpx;
}

.amount-row:first-child {
  margin-top: 0;
}

.amount-row.total {
  margin-top: 22rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.14);
  font-size: 34rpx;
  font-weight: 700;
}

.submit-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: 24rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.96);
  box-shadow: 0 18rpx 48rpx rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(12rpx);
}

.submit-label {
  font-size: 22rpx;
  color: #6b7280;
}

.submit-price {
  margin-top: 6rpx;
  font-size: 38rpx;
  font-weight: 700;
  color: #f97316;
}

.submit-btn {
  margin: 0;
  min-width: 240rpx;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 999rpx;
  border: none;
  background: linear-gradient(135deg, #f97316, #fb7185);
  color: #fff;
  font-size: 28rpx;
  font-weight: 700;
}
