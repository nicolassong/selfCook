.coupon-page {
  min-height: 100vh;
  padding: 32rpx;
  background: linear-gradient(180deg, #fff7ed 0%, #fff 24%, #f8fafc 100%);
}

.page-title {
  margin-bottom: 20rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: #111827;
}

.coupon-card {
  margin-bottom: 20rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fff;
  box-shadow: 0 12rpx 36rpx rgba(15, 23, 42, 0.06);
}

.coupon-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.coupon-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #111827;
}

.coupon-status {
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.coupon-price {
  font-size: 42rpx;
  font-weight: 700;
  color: #f97316;
}

.coupon-text {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b7280;
}
